{
  "name": "fresclean",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "prepare": "husky",
    "test": "turbo test",
    "type-check": "turbo type-check"
  },
  "lint-staged": {
    "*": "bunx ultracite fix"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "dayjs": "^1.11.23",
    "zod": "^4.6.7",
    "typescript": "^7.0.2",
    "libphonenumber-js": "^1.13.15",
    "@biomejs/biome": "2.5.15",
    "hono": "4.13.13",
    "ultracite": "8.0.2"
  }
