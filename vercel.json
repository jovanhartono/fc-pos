{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "cd ../.. && bun run type-check && bun run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/((?!assets/).*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "packages/server",
      "framework": "hono",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://vercel.live 'sha256-IMcnFL+Fk0ngrDxm0PFdDXonngtiu8NAb1OUCvNxAls='; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/internal/photo-sweep", "schedule": "0 20 * * *" },
    { "path": "/api/internal/close-open-shifts", "schedule": "0 17 * * *" },
    { "path": "/api/internal/settle-payment-charges", "schedule": "0 19 * * *" }
  ]
}
