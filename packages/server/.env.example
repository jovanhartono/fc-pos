# Runtime (server boot) — set per Vercel environment (Production / Preview / Development)
DATABASE_URL=            # Neon PostgreSQL connection string for this environment
STORAGE_PREFIX=          # "dev/" or "prod/" — must match the environment DATABASE_URL points at
JWT_SECRET=              # Secret key for JWT authentication
CDN_BASE_URL=            # Public base for stored photo keys
CRON_SECRET=             # Shared secret for /api/internal/*, sent by Vercel cron as Authorization: Bearer
SENTRY_DSN=              # Optional. Unset = reportError is a no-op

# Online payment (ADR-0028) — unset PAYMENT_GATEWAY turns it off
PAYMENT_GATEWAY=         # "midtrans" or "doku"
PUBLIC_WEB_URL=          # Optional, defaults to https://pos.fresclean.id; Track page and webhook URLs sent to the gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=  # "true" for live, otherwise sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=      # "true" for live, otherwise sandbox
DOKU_PRIVATE_KEY=        # Optional, SNAP QRIS: PEM whose public half is uploaded to DOKU, line breaks written as \n
DOKU_QRIS_MERCHANT_ID=   # Optional, SNAP QRIS — all four DOKU_QRIS_*/PRIVATE_KEY set shows the QR inline
DOKU_QRIS_TERMINAL_ID=   # Optional, SNAP QRIS
DOKU_QRIS_POSTAL_CODE=   # Optional, SNAP QRIS
PAYMENT_GATEWAY_MOCK=    # Optional, "true" swaps gateway calls for /api/mock-gateway/<reference>; ignored on Production

# Laptop-only — used by the drizzle CLI (generate/migrate/drift/push/pull), not by the server itself
DATABASE_URL_DEV=        # Dev Neon connection string
DATABASE_URL_PROD=       # Prod Neon connection string
