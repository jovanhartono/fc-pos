# Runtime (server boot) — set per Vercel environment (Production / Preview / Development)
DATABASE_URL=            # Neon PostgreSQL connection string for this environment
STORAGE_PREFIX=          # "dev/" or "prod/" — must match the environment DATABASE_URL points at
JWT_SECRET=              # Secret key for JWT authentication
CDN_BASE_URL=            # Public base for stored photo keys
CRON_SECRET=             # Shared secret for /api/internal/*, sent by Vercel cron as Authorization: Bearer

# Laptop-only — used by the drizzle CLI (generate/migrate/drift/push/pull), not by the server itself
DATABASE_URL_DEV=        # Dev Neon connection string
DATABASE_URL_PROD=       # Prod Neon connection string
