    ],
    "sql": "select distinct on ("processed"."order_service_id") "processed"."order_service_id", "processed"."processed_at", "start_log"."changed_by", "orders"."store_id", ("orders_services"."complaint_id" is not null), exists (select "id" from "order_service_status_logs" "pass_log" where (("pass_log"."order_service_id" = "orders_services"."id") and ("pass_log"."from_status" = $1) and ("pass_log"."to_status" = $2))), exists (select "id" from "complaints" where "complaints"."order_service_id" = "orders_services"."id") from (select "order_service_status_logs"."order_service_id", MIN("order_service_status_logs"."created_at") as "processed_at" from "order_service_status_logs" inner join "orders_services" on "order_service_status_logs"."order_service_id" = "orders_services"."id" inner join "orders" on "orders_services"."order_id" = "orders"."id" where (("order_service_status_logs"."to_status" = $3) and ("order_service_status_logs"."created_at" < $4) and ("orders"."store_id" = $5)) group by "order_service_status_logs"."order_service_id" having ((MIN("order_service_status_logs"."created_at") >= $6) and (MIN("order_service_status_logs"."created_at") < $7))) "processed" inner join "orders_services" on "processed"."order_service_id" = "orders_services"."id" inner join "orders" on "orders_services"."order_id" = "orders"."id" left join "services" on "orders_services"."service_id" = "services"."id" left join "order_service_status_logs" "start_log" on (("start_log"."order_service_id" = "orders_services"."id") and ("start_log"."from_status" = $8) and ("start_log"."to_status" = $9)) order by "processed"."order_service_id", "start_log"."created_at" desc",
  },
  {
    "params": [
      "2026-07-31T17:00:00.000Z",
      "2026-08-31T17:00:00.000Z",
      3,
    ],
    "sql": "select "user_id", "store_id", "clock_in_at", "clock_out_at" from "shifts" where (("shifts"."clock_in_at" >= $1) and ("shifts"."clock_in_at" < $2) and ("shifts"."store_id" = $3))",
  },
