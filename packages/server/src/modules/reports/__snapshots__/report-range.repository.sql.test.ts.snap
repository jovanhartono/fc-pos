exports[`what each money report asks Postgres for one store asks the same question for worker productivity 1`] = `
[
  {
    "params": [
      "processing",
      1,
      "quality_check",
      "ready_for_pickup",
      1,
      "quality_check",
      "ready_for_pickup",
      "quality_check",
      "2026-08-31T17:00:00.000Z",
      3,
      "2026-07-31T17:00:00.000Z",
      "2026-08-31T17:00:00.000Z",
      "queued",
      "processing",
    ],
    "sql": "select distinct on ("processed"."order_service_id") "processed"."order_service_id", "processed"."processed_at", "start_log"."changed_by", "orders"."store_id", "orders_services"."service_id", "services"."name", (select (select "changed_by" from "order_service_status_logs" "clean_log" where (("clean_log"."order_service_id" = "pass_log"."order_service_id") and ("clean_log"."to_status" = $1) and ("clean_log"."created_at" <= "pass_log"."created_at")) order by "clean_log"."created_at" desc, "clean_log"."id" desc limit $2) from "order_service_status_logs" "pass_log" where (("pass_log"."order_service_id" = "orders_services"."id") and ("pass_log"."from_status" = $3) and ("pass_log"."to_status" = $4)) order by "pass_log"."created_at" asc, "pass_log"."id" asc limit $5), ("orders_services"."complaint_id" is not null), exists (select "id" from "order_service_status_logs" "pass_log" where (("pass_log"."order_service_id" = "orders_services"."id") and ("pass_log"."from_status" = $6) and ("pass_log"."to_status" = $7))), exists (select "id" from "complaints" where "complaints"."order_service_id" = "orders_services"."id") from (select "order_service_status_logs"."order_service_id", MIN("order_service_status_logs"."created_at") as "processed_at" from "order_service_status_logs" inner join "orders_services" on "order_service_status_logs"."order_service_id" = "orders_services"."id" inner join "orders" on "orders_services"."order_id" = "orders"."id" where (("order_service_status_logs"."to_status" = $8) and ("order_service_status_logs"."created_at" < $9) and ("orders"."store_id" = $10)) group by "order_service_status_logs"."order_service_id" having ((MIN("order_service_status_logs"."created_at") >= $11) and (MIN("order_service_status_logs"."created_at") < $12))) "processed" inner join "orders_services" on "processed"."order_service_id" = "orders_services"."id" inner join "orders" on "orders_services"."order_id" = "orders"."id" left join "services" on "orders_services"."service_id" = "services"."id" left join "order_service_status_logs" "start_log" on (("start_log"."order_service_id" = "orders_services"."id") and ("start_log"."from_status" = $13) and ("start_log"."to_status" = $14)) order by "processed"."order_service_id", "start_log"."created_at" desc",
  },
  {
    "params": [
      "2026-07-31T17:00:00.000Z",
      "2026-08-31T17:00:00.000Z",
      3,
    ],
    "sql": "select "user_id", "store_id", "clock_in_at", "clock_out_at" from "shifts" where (("shifts"."clock_in_at" >= $1) and ("shifts"."clock_in_at" < $2) and ("shifts"."store_id" = $3))",
  },
  {
    "params": [
      "2026-07-31T17:00:00.000Z",
      "2026-08-31T17:00:00.000Z",
      "processing",
      "quality_check",
      "qc_reject",
      "ready_for_pickup",
      3,
    ],
    "sql": "select "order_service_status_logs"."changed_by", "orders"."store_id", to_char(("order_service_status_logs"."created_at" AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Jakarta', 'YYYY-MM-DD') from "order_service_status_logs" inner join "orders_services" on "order_service_status_logs"."order_service_id" = "orders_services"."id" inner join "orders" on "orders_services"."order_id" = "orders"."id" where (("order_service_status_logs"."created_at" >= $1) and ("order_service_status_logs"."created_at" < $2) and ("order_service_status_logs"."to_status" in ($3, $4, $5, $6)) and ("orders"."store_id" = $7)) group by "order_service_status_logs"."changed_by", "orders"."store_id", to_char(("order_service_status_logs"."created_at" AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Jakarta', 'YYYY-MM-DD')",
  },
  {
    "params": [
      "processing",
      1,
      "qc_reject",
      "quality_check",
      "ready_for_pickup",
      "qc_reject",
      "2026-07-31T17:00:00.000Z",
      "2026-08-31T17:00:00.000Z",
      3,
    ],
    "sql": "select "cleaner_id", "store_id", COUNT(*)::int, (COUNT(*) FILTER (WHERE "checks"."is_reject"))::int from (select (select "changed_by" from "order_service_status_logs" "clean_log" where (("clean_log"."order_service_id" = "qc_check_log"."order_service_id") and ("clean_log"."to_status" = $1) and ("clean_log"."created_at" <= "qc_check_log"."created_at")) order by "clean_log"."created_at" desc, "clean_log"."id" desc limit $2) as "cleaner_id", "orders"."store_id", "qc_check_log"."to_status" = $3 as "is_reject" from "order_service_status_logs" "qc_check_log" inner join "orders_services" on "qc_check_log"."order_service_id" = "orders_services"."id" inner join "orders" on "orders_services"."order_id" = "orders"."id" where (("qc_check_log"."from_status" = $4) and ("qc_check_log"."to_status" in ($5, $6)) and ("qc_check_log"."created_at" >= $7) and ("qc_check_log"."created_at" < $8) and ("orders"."store_id" = $9))) "checks" group by "checks"."cleaner_id", "checks"."store_id"",
  },
]
`;

